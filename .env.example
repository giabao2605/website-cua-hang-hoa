# Supabase Auth dùng thật cho email + mật khẩu + OTP email + Google.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Chỉ dùng phía máy chủ. Không thêm tiền tố NEXT_PUBLIC_ và không commit giá trị thật.
SUPABASE_SECRET_KEY=sb_secret_your_server_key
OTP_HMAC_SECRET=replace-with-at-least-32-random-characters
BREVO_API_KEY=xkeysib-your-brevo-api-key

# Danh sách email quản trị, phân tách bằng dấu phẩy. Không đặt mật khẩu admin trong mã nguồn.
ADMIN_EMAILS=owner@example.com
